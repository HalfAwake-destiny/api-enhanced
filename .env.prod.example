### CORS资源共享设置
## 如果你需要配置, 请取消下面的注释并设置具体的域名
# CORS_ALLOW_ORIGIN = "*"

### 代理设置
## 启用反向代理
ENABLE_PROXY = false
## 代理配置
PROXY_URL = "https://your-proxy-url.com/?proxy="

### 随机IP设置
## 启用随机中国IP（默认关闭）；启用后，所有请求默认使用随机中国IP，除非请求参数randomCNIP显式关闭
ENABLE_RANDOM_CN_IP = false

### UnblockNeteaseMusic 设置项
## 启用全局解灰, 无论是否调用参数都会使用解灰(不推荐开启)
ENABLE_GENERAL_UNBLOCK = false
## 歌曲启用无损音质
ENABLE_FLAC = true
## 启用无损音质时，是否选择音质最高的
SELECT_MAX_BR = false
## 严格按照配置音源设置顺序进行匹配
FOLLOW_SOURCE_ORDER = true
## Cookie设置项; 推荐在Vercel等平台进行环境变量的设置或者设置github secret
# 网易云 cookie
# 格式：MUSIC_U=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NETEASE_COOKIE = ""

### Half Awake blog single-account session
## CloudBase environment ID and server API key; shared clusters need no database password
HALFAWAKE_CLOUDBASE_ENV_ID = "half-awake-d9g69y6lb5d5f79b"
## PostgreSQL database name returned by SELECT current_database()
HALFAWAKE_CLOUDBASE_DATABASE = "pgdb-i6izmvlb"
# CLOUDBASE_APIKEY = ""
## At least 32 random characters; encrypts the NetEase cookie in the database
# NETEASE_SESSION_KEY = ""
## At least 32 random characters; protects the owner-only QR admin endpoints
# MUSIC_ADMIN_TOKEN = ""
## NetEase UID whose playlists are exposed to the blog
HALFAWAKE_NETEASE_UID = "1937961682"
